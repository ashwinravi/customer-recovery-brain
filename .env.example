HYDRA_DB_API_KEY=
HYDRA_DATABASE=customer_recovery_demo
HYDRA_COLLECTION=recovery_knowledge
# openai (also OpenAI-compatible APIs) or anthropic
LLM_PROVIDER=openai
LLM_API_KEY=
# Required: use the model available in your account
LLM_MODEL=
# Optional for OpenAI-compatible providers; omit for OpenAI itself
LLM_BASE_URL=
PORT=8080
# Optional: "none" disables thinking on local reasoning models (Ollama qwen3.5)
LLM_REASONING_EFFORT=
# Optional: soft answer-length limit (faster local generation), e.g. 250
LLM_MAX_WORDS=
